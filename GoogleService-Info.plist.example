<?xml version="1.0" encoding="UTF-8"?>
<!--
  GoogleService-Info.plist — TEMPLATE / EXAMPLE

  This is NOT used at build time. Copy it to `GoogleService-Info.plist`
  (same folder, gitignored) and replace every REPLACE_WITH_* value with the
  real one from the Firebase console, OR just run:

      scripts/setup-firebase.sh

  which fills it in automatically (from an installed /Applications/VibeCount.app
  or a plist you point it at).

  Where the real values come from:
      Firebase console  →  project "vibe-count-app-0703"  →  Project settings
      →  Your apps  →  the Apple app (com.vibecount.app)
      →  "GoogleService-Info.plist"  →  Download

  Without a real GoogleService-Info.plist the app still builds and runs, but
  it falls back to local-only mode (no cross-device leaderboard sync).

  BUNDLE_ID / PROJECT_ID below are the shared project's public identifiers and
  can stay as-is when connecting to the existing backend.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>API_KEY</key>
	<string>REPLACE_WITH_API_KEY</string>
	<key>GCM_SENDER_ID</key>
	<string>REPLACE_WITH_GCM_SENDER_ID</string>
	<key>PLIST_VERSION</key>
	<string>1</string>
	<key>BUNDLE_ID</key>
	<string>com.vibecount.app</string>
	<key>PROJECT_ID</key>
	<string>vibe-count-app-0703</string>
	<key>STORAGE_BUCKET</key>
	<string>REPLACE_WITH_STORAGE_BUCKET</string>
	<key>IS_ADS_ENABLED</key>
	<false/>
	<key>IS_ANALYTICS_ENABLED</key>
	<false/>
	<key>IS_APPINVITE_ENABLED</key>
	<true/>
	<key>IS_GCM_ENABLED</key>
	<true/>
	<key>IS_SIGNIN_ENABLED</key>
	<true/>
	<key>GOOGLE_APP_ID</key>
	<string>REPLACE_WITH_GOOGLE_APP_ID</string>
</dict>
</plist>
